# The agent reads its OpenRouter key from the environment variable below.
# You do NOT need this file if your key already lives in another .env
# (e.g. your HW1 repo's .env) — just point RUMOR_AGENT_ENV_FILE at it:
#
#     export RUMOR_AGENT_ENV_FILE=~/path/to/your/existing/.env
#
# Only if you have no .env yet: copy this file to ".env" in this folder,
# paste your key after the =, and keep the file private. ".env" is listed
# in .gitignore — never commit it, and never paste the key into chat,
# code, or a report.

OPENROUTER_API_KEY=
